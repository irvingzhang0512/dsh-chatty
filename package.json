{
  "name": "@irvingzhang0512/dsh-chatty",
  "version": "0.2.1-rc.2+chatty.1",
  "description": "基于官方语音 Bundle 的持续听写、语音口令、草稿润色与独立朗读增强。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/*.js",
    "lib/speech/*.js",
    "lib/stt/*.js",
    "lib/tts/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "compatibility.json",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "stt",
    "tts",
    "vad",
    "dictation",
    "speech",
    "volcano",
    "siliconflow"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "pretest": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "link:peers": "node scripts/link-peer-deps.mjs",
    "release:check": "node scripts/build-client.mjs && node scripts/lint.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-experimental-voice-input-bundle": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-speech-to-text": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-api-speech-to-text": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-speech-to-text-sensevoice": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-client-ui-voice-input": "0.2.1-rc.2",
    "@deepseek-ai/dsh-native-command": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-native-command": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials-local": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/irvingzhang0512/dsh-chatty.git"
  },
  "engines": {
    "dsh": "0.2.1-rc.2"
  }
}
